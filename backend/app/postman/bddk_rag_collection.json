{
    "info": {
        "name": "BDDK RAG Asistanı API",
        "description": "Softtech Regülasyon RAG sistemi kurumsal uç nokta (endpoint) testleri.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Soru Sor (/api/chat/chat)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"message\": \"Birincil sistemlerin yedekleri ikincil sistem sayılır mı?\",\n    \"session_id\": \"test_01\"\n}"
                },
                "url": {
                    "raw": "http://127.0.0.1:8000/api/chat/chat",
                    "protocol": "http",
                    "host": ["127", "0", "0", "1"],
                    "port": "8000",
                    "path": ["api", "chat", "chat"]
                }
            }
        },
        {
            "name": "2. Dinamik Belge Yükle (/api/documents/upload)",
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "file",
                            "type": "file",
                            "description": "Yüklenecek PDF dosyası"
                        }
                    ]
                },
                "url": {
                    "raw": "http://127.0.0.1:8000/api/documents/upload",
                    "protocol": "http",
                    "host": ["127", "0", "0", "1"],
                    "port": "8000",
                    "path": ["api", "documents", "upload"]
                }
            }
        },
        {
            "name": "3. Geçmiş Logları Getir (/api/chat/logs)",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "http://127.0.0.1:8000/api/chat/logs?limit=10&skip=0",
                    "protocol": "http",
                    "host": ["127", "0", "0", "1"],
                    "port": "8000",
                    "path": ["api", "chat", "logs"],
                    "query": [
                        {
                            "key": "limit",
                            "value": "10"
                        },
                        {
                            "key": "skip",
                            "value": "0"
                        }
                    ]
                }
            }
        },
        {
            "name": "4. Geri Bildirim Güncelle (/api/chat/logs/{log_id})",
            "request": {
                "method": "PUT",
                "header": [],
                "url": {
                    "raw": "http://127.0.0.1:8000/api/chat/logs/1?is_helpful=true",
                    "protocol": "http",
                    "host": ["127", "0", "0", "1"],
                    "port": "8000",
                    "path": ["api", "chat", "logs", "1"],
                    "query": [
                        {
                            "key": "is_helpful",
                            "value": "true"
                        }
                    ]
                }
            }
        },
        {
            "name": "5. Log Sil (/api/chat/logs/{log_id})",
            "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                    "raw": "http://127.0.0.1:8000/api/chat/logs/1",
                    "protocol": "http",
                    "host": ["127", "0", "0", "1"],
                    "port": "8000",
                    "path": ["api", "chat", "logs", "1"]
                }
            }
        },
        {
            "name": "6. Yüklenen Belgeleri Getir (/api/documents)",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "http://127.0.0.1:8000/api/documents",
                    "protocol": "http",
                    "host": ["127", "0", "0", "1"],
                    "port": "8000",
                    "path": ["api", "documents"]
                }
            }
        }
    ]
}